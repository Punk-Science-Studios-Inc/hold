#include <winver.h>

1 ICON "eye_open.ico"
2 ICON "eye_closed.ico"
1 24 "hold.exe.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_NUM
PRODUCTVERSION VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Keeps Windows awake"
      VALUE "ProductName", "Hold"
      VALUE "FileVersion", VERSION_STR
      VALUE "ProductVersion", VERSION_STR
      VALUE "OriginalFilename", "hold.exe"
      VALUE "LegalCopyright", "Copyright (c) 2026 Darryl Wright"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
